<?xml version="1.0" encoding="utf-8"?>
<!-- Session rows hold per-device timing anchors and DND ownership; restoring them elsewhere is wrong. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
